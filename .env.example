# 이 파일을 .env.local로 복사해서 사용하세요.  (cp .env.example .env.local)

# ── 백엔드 연동 ─────────────────────────────────────────────
# 서버(Next.js) 전용. 배포된 백엔드 주소를 넣으면 /api/v1/* 요청이 이 주소로 중계된다.
# 예: https://api.example.com  (끝에 / 없이)
BACKEND_ORIGIN=

# 브라우저가 호출하는 주소. 로그인 쿠키 때문에 반드시 상대 경로로 둔다.
NEXT_PUBLIC_API_URL=/api/v1

# ── 목데이터 ────────────────────────────────────────────────
# true  : 백엔드 없이 목데이터로 동작 (아무 아이디/비밀번호로 로그인 가능)
# false : BACKEND_ORIGIN의 실제 백엔드와 연동
# 값을 바꾸면 개발 서버 재시작(또는 재빌드)이 필요하다.
NEXT_PUBLIC_USE_MOCK=true

# ── 제어 명령 확인 (선택, ms) ────────────────────────────────
# 비워두면 1000 / 5000
NEXT_PUBLIC_COMMAND_POLL_INTERVAL_MS=
NEXT_PUBLIC_COMMAND_TIMEOUT_MS=
